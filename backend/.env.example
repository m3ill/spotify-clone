# Copy to .env and fill with your own local PostgreSQL values.
PGHOST=localhost
PGPORT=5432
PGDATABASE=spotify_clone
PGUSER=your_postgres_user
PGPASSWORD=replace_with_your_local_password

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_session_secret
